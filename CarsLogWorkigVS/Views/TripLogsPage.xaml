<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.TripLogsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Журнал поїздок" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="+" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="26" WidthRequest="44" Clicked="OnAddClicked" />
            </Grid>
        </Frame>

        <CollectionView Grid.Row="1" x:Name="TripCollection"
                        EmptyView="Поїздок не знайдено. Додайте першу поїздку."
                        Margin="16,8">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{StaticResource White}" CornerRadius="14" Margin="0,4"
                           HasShadow="False" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding TripDate, StringFormat='{0:dd.MM.yyyy}'}"
                                       FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                <Label FontSize="15" FontAttributes="Bold" TextColor="{StaticResource LabelPrimary}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DeparturePoint}" />
                                            <Span Text=" → " TextColor="{StaticResource PrimaryAction}" />
                                            <Span Text="{Binding Destination}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Purpose}" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding DistanceKm, StringFormat='{0} км'}"
                                   FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryAction}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
