<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.AdminPanelPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Панель адміна" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center"
                       Margin="-44,0,0,0" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Frame x:Name="AccessDeniedFrame" BackgroundColor="{StaticResource WarningBackground}" CornerRadius="16"
                       HasShadow="False" Padding="20" IsVisible="False">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🔒" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="Доступ заборонено" FontSize="17" FontAttributes="Bold"
                               TextColor="{StaticResource Alert}" HorizontalOptions="Center" />
                        <Label Text="Ця панель доступна лише для Admin та SuperAdmin."
                               FontSize="14" TextColor="{StaticResource LabelSecondary}" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout x:Name="AdminContent" IsVisible="False" Spacing="12">

                    <Frame Style="{StaticResource CardFrameStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="⚙️ Адміністрування" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                            <Label x:Name="AdminInfoLabel" Text="" FontSize="14" TextColor="{StaticResource LabelSecondary}" />
                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="Управління користувачами" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource LabelPrimary}" Margin="4,4,0,0" />

                    <Frame BackgroundColor="{StaticResource White}" CornerRadius="16" HasShadow="False" Padding="0">
                        <VerticalStackLayout Spacing="0">

                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnActivateUserTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Активувати користувача" FontSize="15" TextColor="{StaticResource LabelPrimary}" />
                                    <Label Text="Встановити статус Online" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Separator}" Margin="16,0" />

                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDeactivateUserTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Деактивувати користувача" FontSize="15" TextColor="{StaticResource LabelPrimary}" />
                                    <Label Text="Встановити статус Offline" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Separator}" Margin="16,0" />

                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAssignRoleTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Змінити роль" FontSize="15" TextColor="{StaticResource LabelPrimary}" />
                                    <Label Text="Owner / Driver" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <Label x:Name="SuperAdminSection" Text="SuperAdmin" FontSize="15"
                           FontAttributes="Bold" TextColor="{StaticResource LabelPrimary}" Margin="4,4,0,0"
                           IsVisible="False" />

                    <Frame x:Name="SuperAdminFrame" BackgroundColor="{StaticResource White}" CornerRadius="16"
                           HasShadow="False" Padding="0" IsVisible="False">
                        <VerticalStackLayout Spacing="0">

                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateAdminTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Призначити адміна" FontSize="15" TextColor="{StaticResource LabelPrimary}" />
                                    <Label Text="Надати права Admin" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Separator}" Margin="16,0" />

                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRemoveAdminTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Зняти права адміна" FontSize="15" TextColor="{StaticResource Alert}" />
                                    <Label Text="Повернути роль Driver" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Separator}" Margin="16,0" />

                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnViewUserProfileTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Переглянути профіль" FontSize="15" TextColor="{StaticResource LabelPrimary}" />
                                    <Label Text="Перегляд профілю іншого користувача" FontSize="12" TextColor="{StaticResource LabelSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <Label x:Name="ResultLabel" Text="" FontSize="14" TextColor="{StaticResource Success}"
                           HorizontalOptions="Center" IsVisible="False" Margin="0,8" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
