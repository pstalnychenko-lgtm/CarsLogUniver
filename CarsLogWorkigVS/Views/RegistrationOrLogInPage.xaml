<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.RegistrationOrLogInPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid>
        <Image Source="dotnet_bot.png" 
               Aspect="AspectFill" 
               Opacity="0.05" 
               VerticalOptions="Fill" 
               HorizontalOptions="Fill" />

        <VerticalStackLayout VerticalOptions="Center" 
                             HorizontalOptions="Center" 
                             Spacing="24" 
                             Padding="30">

            <Border BackgroundColor="{StaticResource White}"
                    WidthRequest="120"
                    HeightRequest="120"
                    StrokeShape="RoundRectangle 30"
                    StrokeThickness="0"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                </Border.Shadow>
                <Label Text="🚗" 
                       FontSize="60" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="АвтоЖурнал" 
                       FontSize="36" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource LabelPrimary}" 
                       HorizontalOptions="Center" />
                <Label Text="Твій надійний помічник у догляді за авто" 
                       FontSize="16" 
                       TextColor="{StaticResource LabelSecondary}" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16" Margin="0,20,0,0">
                <Button Text="Увійти"
                        Style="{StaticResource PrimaryButtonStyle}"
                        WidthRequest="280"
                        HeightRequest="56"
                        Clicked="OnLoginClicked">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource PrimaryAction}" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <Button Text="Зареєструватися"
                        BackgroundColor="{StaticResource White}"
                        TextColor="{StaticResource PrimaryAction}"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="14"
                        BorderColor="{StaticResource PrimaryAction}"
                        BorderWidth="2"
                        WidthRequest="280"
                        HeightRequest="56"
                        Clicked="OnRegisterClicked" />

                <Button Text="Продовжити як гість"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource LabelSecondary}"
                        FontSize="15"
                        FontAttributes="Italic"
                        WidthRequest="280"
                        HeightRequest="44"
                        Clicked="OnGuestClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
