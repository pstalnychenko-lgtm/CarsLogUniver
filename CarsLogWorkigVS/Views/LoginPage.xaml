<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">

        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Вхід" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" Margin="-44,0,0,0" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="24" VerticalOptions="Center">

                <Label Text="Введіть дані для входу" FontSize="15" TextColor="{StaticResource LabelSecondary}"
                       HorizontalOptions="Center" Margin="0,16,0,8" />

                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="LoginEntry" Placeholder="Логін" Style="{StaticResource FormEntryStyle}" ReturnType="Next" />
                </Frame>

                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" Style="{StaticResource FormEntryStyle}" ReturnType="Done" />
                </Frame>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorLabelStyle}" IsVisible="False" />

                <Button Text="Увійти" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnLoginClicked" />

                <Label Text="Немає акаунту? Зареєструватися"
                       TextColor="{StaticResource PrimaryAction}" FontSize="14"
                       HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
