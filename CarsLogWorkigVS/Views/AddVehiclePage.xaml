<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.AddVehiclePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">

        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Новий автомобіль" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="Зберегти" Style="{StaticResource HeaderButtonStyle}" Clicked="OnSaveClicked" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Label Text="Номерний знак *" Style="{StaticResource FormLabelStyle}" Margin="4,8,0,0" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="PlateEntry" Placeholder="AA0000AA" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="VIN *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="VinEntry" Placeholder="17 символів" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Марка *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="BrandEntry" Placeholder="Toyota, BMW..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Модель *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="ModelEntry" Placeholder="Camry, X5..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Колір" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="ColorEntry" Placeholder="Білий, Чорний..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Тип кузова" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <Picker x:Name="BodyTypePicker" Style="{StaticResource FormPickerStyle}">
                        <Picker.Items>
                            <x:String>Седан</x:String>
                            <x:String>Хетчбек</x:String>
                            <x:String>Універсал</x:String>
                            <x:String>Позашляховик (SUV)</x:String>
                            <x:String>Мінівен</x:String>
                            <x:String>Купе</x:String>
                            <x:String>Кабріолет</x:String>
                            <x:String>Пікап</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>

                <Label Text="Об'єм двигуна (куб. см) *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="EngineEntry" Placeholder="1600" Keyboard="Numeric" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Об'єм бака (л) *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="TankEntry" Placeholder="50" Keyboard="Numeric" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Тип палива" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <Picker x:Name="FuelTypePicker" Style="{StaticResource FormPickerStyle}">
                        <Picker.Items>
                            <x:String>Бензин</x:String>
                            <x:String>Дизель</x:String>
                            <x:String>Електро</x:String>
                            <x:String>Гібрид</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>

                <Label Text="Рік випуску" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <DatePicker x:Name="YearPicker" Format="yyyy" Style="{StaticResource FormDatePickerStyle}" />
                </Frame>

                <Label Text="Поточний пробіг (км)" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="MileageEntry" Placeholder="0" Keyboard="Numeric" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorLabelStyle}" IsVisible="False" Margin="0,4" />

                <Button Text="Зберегти автомобіль" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
