<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarsLogWorkigVS.ViewModels"
             x:Class="CarsLogWorkigVS.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="{StaticResource White}" StrokeThickness="0" Padding="15,25,15,15">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Створення профілю" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" Margin="-44,0,0,0" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="24">
                
                <Label Text="АвтоЖурнал" 
                       FontSize="34" 
                       FontFamily="OpenSans-Semibold"
                       FontAttributes="Bold" 
                       TextColor="{StaticResource PrimaryAction}" 
                       HorizontalOptions="Center" 
                       Margin="0,10,0,10" />

                <Label Text="Персональні дані" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,0" />
                <Border BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        
                        <Label Text="Ім'я" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding FirstName}" Placeholder="Введіть ім'я" Style="{StaticResource FormEntryStyle}" />
                        </Border>

                        <Label Text="Прізвище" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding LastName}" Placeholder="Введіть прізвище" Style="{StaticResource FormEntryStyle}" />
                        </Border>

                        <Label Text="Стать" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,0">
                            <Picker ItemsSource="{Binding Genders}" SelectedIndex="{Binding GenderIndex}" Style="{StaticResource FormPickerStyle}" Title="Оберіть стати" />
                        </Border>

                        <Label Text="Логін" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding Login}" Placeholder="Створіть логін" Style="{StaticResource FormEntryStyle}" />
                        </Border>

                        <Label Text="Email" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding Email}" Placeholder="example@email.com" Keyboard="Email" Style="{StaticResource FormEntryStyle}" />
                        </Border>

                        <Label Text="Телефон" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding Phone}" Placeholder="+380..." Keyboard="Telephone" Style="{StaticResource FormEntryStyle}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Безпека" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,0" />
                <Border BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Пароль" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding Password}" Placeholder="Мін. 8 символів, велика літера, цифра" IsPassword="True" Style="{StaticResource FormEntryStyle}" />
                        </Border>

                        <Label Text="Підтвердження паролю" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding ConfirmPassword}" Placeholder="Повторіть пароль" IsPassword="True" Style="{StaticResource FormEntryStyle}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Професійна інформація" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,0" />
                <Border BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Роль" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="2" Stroke="{StaticResource PrimaryAction}" Padding="8,0">
                            <Picker SelectedIndex="{Binding RoleIndex}" Style="{StaticResource FormPickerStyle}" Title="Оберіть вашу роль">
                                <Picker.Items>
                                    <x:String>Власник (Owner)</x:String>
                                    <x:String>Водій (Driver)</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Label Text="Група крові (для водіїв)" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="8,0">
                            <Picker ItemsSource="{Binding BloodTypes}" SelectedIndex="{Binding BloodTypeIndex}" Style="{StaticResource FormPickerStyle}" Title="Оберіть групу крові" />
                        </Border>

                        <Label Text="Секретний код (для Адмінів)" Style="{StaticResource FormLabelStyle}" />
                        <Border BackgroundColor="{StaticResource SystemBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16,4">
                            <Entry Text="{Binding SecretCode}" Placeholder="Лише для спеціальних ролей" Style="{StaticResource FormEntryStyle}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasError}" Margin="0,4" />

                <Button Text="Зареєструватися" Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
