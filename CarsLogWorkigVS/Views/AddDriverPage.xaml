<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.AddDriverPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Новий водій" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="Зберегти" Style="{StaticResource HeaderButtonStyle}" Clicked="OnSaveClicked" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Label Text="Ім'я *" Style="{StaticResource FormLabelStyle}" Margin="4,8,0,0" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="FirstNameEntry" Placeholder="Ім'я" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Прізвище *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="LastNameEntry" Placeholder="Прізвище" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Телефон *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="PhoneEntry" Placeholder="+380..." Keyboard="Telephone" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Номер посвідчення водія *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="LicenseEntry" Placeholder="DRV-1234567" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Орган видачі посвідчення *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="IssuedByEntry" Placeholder="ТСЦ №..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Дата закінчення посвідчення *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <DatePicker x:Name="ExpiryDatePicker" Format="dd.MM.yyyy" Style="{StaticResource FormDatePickerStyle}" />
                </Frame>

                <Label Text="Група крові" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <Picker x:Name="BloodTypePicker" Style="{StaticResource FormPickerStyle}">
                        <Picker.Items>
                            <x:String>A+</x:String>
                            <x:String>A-</x:String>
                            <x:String>B+</x:String>
                            <x:String>B-</x:String>
                            <x:String>AB+</x:String>
                            <x:String>AB-</x:String>
                            <x:String>O+</x:String>
                            <x:String>O-</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>

                <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                    <Label Grid.Column="0" Text="Наявність медичної довідки"
                           FontSize="15" TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                    <Switch x:Name="MedCertSwitch" Grid.Column="1" IsToggled="True" />
                </Grid>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorLabelStyle}" IsVisible="False" />

                <Button Text="Додати водія" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
