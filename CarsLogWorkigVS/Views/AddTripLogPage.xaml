<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.AddTripLogPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Нова поїздка" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="Зберегти" Style="{StaticResource HeaderButtonStyle}" Clicked="OnSaveClicked" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Label Text="Дата поїздки" Style="{StaticResource FormLabelStyle}" Margin="4,8,0,0" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <DatePicker x:Name="TripDatePicker" Format="dd.MM.yyyy" Style="{StaticResource FormDatePickerStyle}" />
                </Frame>

                <Label Text="Точка відправлення *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="DepartureEntry" Placeholder="Місто, вул. ..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Пункт призначення *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="DestinationEntry" Placeholder="Місто, вул. ..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Мета поїздки" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <Picker x:Name="PurposePicker" Style="{StaticResource FormPickerStyle}">
                        <Picker.Items>
                            <x:String>Особиста</x:String>
                            <x:String>Ділова</x:String>
                            <x:String>Сервісна</x:String>
                            <x:String>Інша</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>

                <Label Text="Пробіг на початку (км) *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="StartMileageEntry" Keyboard="Numeric" Placeholder="0" Style="{StaticResource FormEntryStyle}"
                           TextChanged="OnMileageChanged" />
                </Frame>

                <Label Text="Пробіг в кінці (км) *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="EndMileageEntry" Keyboard="Numeric" Placeholder="0" Style="{StaticResource FormEntryStyle}"
                           TextChanged="OnMileageChanged" />
                </Frame>

                <Frame Style="{StaticResource InfoFrameStyle}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Відстань:" FontSize="15" TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" />
                        <Label x:Name="DistanceLabel" Text="0 км" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryAction}" Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Label Text="Нотатки" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,8">
                    <Editor x:Name="NotesEditor" Placeholder="Коментар до поїздки..."
                            FontSize="15" TextColor="{StaticResource LabelPrimary}" PlaceholderColor="{StaticResource PlaceholderColor}"
                            AutoSize="TextChanges" MinimumHeightRequest="80" />
                </Frame>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorLabelStyle}" IsVisible="False" />

                <Button Text="Зберегти поїздку" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
