<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.VehicleDetailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">

        <Frame Grid.Row="0" BackgroundColor="{StaticResource PrimaryAction}" CornerRadius="0" HasShadow="True" Padding="15,30,15,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" TextColor="{StaticResource White}" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label x:Name="VehicleNameLabel" Text="" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource White}" HorizontalOptions="Center" />
                    <Label x:Name="PlateLabel" Text="" FontSize="14" TextColor="{StaticResource OnPrimaryText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="✎" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="18" WidthRequest="44" TextColor="{StaticResource White}" Clicked="OnEditClicked" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label x:Name="MileageLabel" Text="0" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryAction}" HorizontalOptions="Center" />
                            <Label Text="км" FontSize="12" TextColor="{StaticResource LabelSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label x:Name="FuelTypeLabel" Text="-" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Success}" HorizontalOptions="Center" />
                            <Label Text="паливо" FontSize="12" TextColor="{StaticResource LabelSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label x:Name="EngineLabel" Text="-" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource AdminColor}" HorizontalOptions="Center" />
                            <Label Text="куб. см" FontSize="12" TextColor="{StaticResource LabelSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Label Text="Дії" Style="{StaticResource SectionHeaderStyle}" Margin="4,0" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource CardFrameStyle}" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFuelTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="⛽" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Паливо" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource LabelPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource CardFrameStyle}" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTripsTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🗺️" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Поїздки" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource LabelPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource CardFrameStyle}" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnServiceTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🔧" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Сервіс" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource LabelPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource CardFrameStyle}" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpensesTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="💰" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Витрати" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource LabelPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="2" Grid.Column="0" Style="{StaticResource CardFrameStyle}" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDocumentsTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📄" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Документи" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource LabelPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Row="2" Grid.Column="1" Style="{StaticResource CardFrameStyle}" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotesTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📝" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Нотатки" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource LabelPrimary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <Frame Style="{StaticResource CardFrameStyle}" Margin="0,4">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnComponentsTapped" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="🔩 Компоненти та запчастини" FontSize="15"
                                   FontAttributes="Bold" TextColor="{StaticResource LabelPrimary}" />
                            <Label x:Name="ExpiredComponentsLabel" Text="" FontSize="13" TextColor="{StaticResource Alert}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Button Text="Видалити автомобіль" BackgroundColor="{StaticResource WarningBackground}" TextColor="{StaticResource Alert}"
                        FontAttributes="Bold" FontSize="15" CornerRadius="12"
                        HeightRequest="48" Margin="0,4,0,24" Clicked="OnDeleteClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
