<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.AddDocumentPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Новий документ" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="Зберегти" Style="{StaticResource HeaderButtonStyle}" Clicked="OnSaveClicked" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Label Text="Назва документа *" Style="{StaticResource FormLabelStyle}" Margin="4,8,0,0" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="TitleEntry" Placeholder="Техпаспорт, Страховка..." Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Тип документа" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <Picker x:Name="DocTypePicker" Style="{StaticResource FormPickerStyle}">
                        <Picker.Items>
                            <x:String>Реєстрація ТЗ</x:String>
                            <x:String>Страхування</x:String>
                            <x:String>Техогляд</x:String>
                            <x:String>Інше</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>

                <Label Text="Дата видачі" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <DatePicker x:Name="IssueDatePicker" Format="dd.MM.yyyy" Style="{StaticResource FormDatePickerStyle}" />
                </Frame>

                <Label Text="Номер полісу (необов'язково)" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="PolicyEntry" Placeholder="AE1234567" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorLabelStyle}" IsVisible="False" />

                <Button Text="Зберегти документ" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
