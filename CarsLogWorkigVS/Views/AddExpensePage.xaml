<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.AddExpensePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Нова витрата" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="Зберегти" Style="{StaticResource HeaderButtonStyle}" Clicked="OnSaveClicked" />
            </Grid>
        </Frame>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16">

                <Label Text="Категорія *" Style="{StaticResource FormLabelStyle}" Margin="4,8,0,0" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <Picker x:Name="CategoryPicker" Style="{StaticResource FormPickerStyle}">
                        <Picker.Items>
                            <x:String>Паливо</x:String>
                            <x:String>Сервіс</x:String>
                            <x:String>Страхування</x:String>
                            <x:String>Штраф</x:String>
                            <x:String>Парковка</x:String>
                            <x:String>Мийка</x:String>
                            <x:String>Зміна шин</x:String>
                            <x:String>Інше</x:String>
                        </Picker.Items>
                    </Picker>
                </Frame>

                <Label Text="Сума (грн) *" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,4">
                    <Entry x:Name="AmountEntry" Keyboard="Numeric" Placeholder="0.00" Style="{StaticResource FormEntryStyle}" />
                </Frame>

                <Label Text="Дата" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="8,0">
                    <DatePicker x:Name="DatePicker" Format="dd.MM.yyyy" Style="{StaticResource FormDatePickerStyle}" />
                </Frame>

                <Label Text="Опис" Style="{StaticResource FormLabelStyle}" />
                <Frame BackgroundColor="{StaticResource White}" CornerRadius="12" HasShadow="False" Padding="16,8">
                    <Editor x:Name="DescEditor" Placeholder="Деталі витрати..."
                            FontSize="15" TextColor="{StaticResource LabelPrimary}" PlaceholderColor="{StaticResource PlaceholderColor}"
                            AutoSize="TextChanges" MinimumHeightRequest="70" />
                </Frame>

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorLabelStyle}" IsVisible="False" />

                <Button Text="Зберегти витрату" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
