<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarsLogWorkigVS.Views.VehicleListPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SystemBackground}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Frame Grid.Row="0" BackgroundColor="{StaticResource White}" CornerRadius="0" HasShadow="True" Padding="15,25,15,15">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="←" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="20" WidthRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Мої автомобілі" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource LabelPrimary}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" x:Name="AddButton" Text="+" Style="{StaticResource HeaderButtonStyle}"
                        FontSize="26" WidthRequest="44" Clicked="OnAddClicked" />
            </Grid>
        </Frame>

        <Frame Grid.Row="1" BackgroundColor="{StaticResource White}" CornerRadius="0" Padding="12,8" HasShadow="False">
            <Frame BackgroundColor="{StaticResource SystemBackground}" CornerRadius="10" Padding="10,4" HasShadow="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" Margin="0,0,6,0" />
                    <Entry Grid.Column="1" x:Name="SearchEntry" Placeholder="Пошук за маркою, моделлю, номером..."
                           FontSize="15" TextColor="{StaticResource LabelPrimary}" PlaceholderColor="{StaticResource PlaceholderColor}"
                           Text="{Binding SearchQuery, Mode=TwoWay}" />
                </Grid>
            </Frame>
        </Frame>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}">
            <CollectionView x:Name="VehiclesCollection"
                            ItemsSource="{Binding FilteredVehicles}"
                            SelectionMode="Single"
                            SelectionChanged="OnVehicleSelected"
                            EmptyView="Список порожній. Додайте перший автомобіль."
                            Margin="16,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrameStyle}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Brand, StringFormat='{0} '}" FontSize="17"
                                           FontAttributes="Bold" TextColor="{StaticResource LabelPrimary}" />
                                    <Label Text="{Binding Model}" FontSize="15" TextColor="{StaticResource LabelSecondary}" />
                                    <Label Text="{Binding PlateNumber}" FontSize="13" TextColor="{StaticResource LabelSecondary}" />
                                    <Label Text="{Binding CurrentMileage, StringFormat='Пробіг: {0} км'}"
                                           FontSize="13" TextColor="{StaticResource PrimaryAction}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                                    <Label Text="{Binding FuelType}" FontSize="12" TextColor="{StaticResource LabelSecondary}"
                                           HorizontalOptions="End" />
                                    <Label Text="›" FontSize="22" TextColor="{StaticResource LabelTertiary}" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
