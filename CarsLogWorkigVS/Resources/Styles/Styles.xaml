    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SystemBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource SystemBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource LabelPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource LabelPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Gray200}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Gray200}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryAction}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource PrimaryAction}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource LabelSecondary}" />
    </Style>

    <!-- Custom Project Styles -->

    <Style x:Key="FormLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource LabelSecondary}" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style x:Key="FormInputStyle" TargetType="View">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FormEntryStyle" TargetType="Entry" BasedOn="{StaticResource FormInputStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource LabelPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource PlaceholderColor}" />
    </Style>

    <Style x:Key="FormPickerStyle" TargetType="Picker" BasedOn="{StaticResource FormInputStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource LabelPrimary}" />
    </Style>

    <Style x:Key="FormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FormInputStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource LabelPrimary}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAction}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryAction}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="InfoFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource InfoBackground}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource LabelPrimary}" />
        <Setter Property="Margin" Value="4,8,0,4" />
    </Style>

    <Style x:Key="ErrorLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Alert}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

</ResourceDictionary>
